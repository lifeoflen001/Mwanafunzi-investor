APP_NAME="Mwanafunzi Investor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Optional immutable asset/CDN origin. Leave blank for same-origin delivery.
ASSET_URL=
# Optional public-media CDN origin. Private customer files never use this disk.
CDN_URL=
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Use file maintenance mode on shared hosting unless a shared cache store is configured.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Production uses MySQL/MariaDB. SQLite remains suitable for isolated tests.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# This project uses database-backed sessions. The sessions migration is included.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# local is used for private commerce files; public media uses the public disk and storage link.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# The sandbox gateway is for local/testing only. Configure Flutterwave before enabling live commerce.
PAYMENT_PROVIDER=sandbox
PAYMENT_ENVIRONMENT=sandbox
COMMERCE_CURRENCY=TZS
DOWNLOAD_URL_LIFETIME=10
COMMERCE_TAX_ENABLED=false
COMMERCE_TAX_LABEL=Tax
COMMERCE_TAX_RATE=0
COMMERCE_PRICES_INCLUDE_TAX=false
BUSINESS_TAX_IDENTIFIER=
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_ENVIRONMENT=sandbox
FLW_BASE_URL=https://api.flutterwave.com/v3

# Production admin accounts require TOTP MFA by default. Keep these values out of the repository's real .env.
ADMIN_MFA_REQUIRED=true
OUTBOUND_CONNECT_TIMEOUT=10
OUTBOUND_TIMEOUT=20

# Database cache is shared-hosting compatible and has a migration in this project.
CACHE_STORE=database
# CACHE_PREFIX=mwanafunzi-investor-cache-

# Optional cache/queue alternatives; leave unset unless the service is provisioned.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# Local development writes mail to the log. Production should use authenticated SMTP.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=20

# Google reCAPTCHA v3 (keep the secret out of source control)
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERSION=v3
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_HOSTNAME=
RECAPTCHA_TIMEOUT=5
RECAPTCHA_FORM_LOGIN=true
RECAPTCHA_FORM_ADMIN_LOGIN=true
RECAPTCHA_FORM_REGISTER=true
RECAPTCHA_FORM_PASSWORD_RESET=true
RECAPTCHA_FORM_CONTACT=true
RECAPTCHA_FORM_COMMENTS=true
RECAPTCHA_FORM_WAITLIST=true
RECAPTCHA_FORM_CHECKOUT=true
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

# Optional provider integrations. Keep credentials out of Git.
POSTMARK_API_KEY=
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
